#!/bin/sh
set -e

### BEGIN INIT INFO
# Provides:           moblab-docker-registry
# Required-Start:     docker
# Required-Stop:      docker
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Create lightweight, portable, self-sufficient containers.
# Description: Docker registry to allow for local moblab development
### END INIT INFO


. /lib/lsb/init-functions

# Carry out specific functions when asked to by the system
case "$1" in
    start)
        echo "Starting script moblab "
        docker run -d -p 5000:5000 --name registry registry:2 || true
    ;;
    stop)
        echo "Stopping script moblab-registry"
        docker stop registry
    ;;
    e)
        echo "Usage: /etc/init.d/moblab-docker-registry {start|stop}"
        exit 1
    ;;
esac

exit 0

