#!/bin/sh
set -e

### BEGIN INIT INFO
# Provides:           moblab-host-server
# Required-Start:     docker
# Required-Stop:      docker
# Default-Start:      2 3 4 5
# Default-Stop:       0 1 6
# Short-Description:  Create lightweight, portable, self-sufficient containers.
# Description: Moblab host server to provide OS information to moblab software.
### END INIT INFO


. /lib/lsb/init-functions

# Some things that run always
#touch /var/lock/moblab

# Carry out specific functions when asked to by the system
case "$1" in
    start)
        echo "Starting script moblab-host-server "

        # setup the log file if it hasn't been set
        mkdir -p /var/log/bootup
        touch /var/log/bootup/hostservices.log
        /etc/moblab/host_server/host_server_debian.py&

    ;;
    stop)
        echo "Stopping script moblab-host-server"
    ;;
    *)
        echo "Usage: /etc/init.d/moblab-host-server {start|stop}"
        exit 1
    ;;
esac

exit 0

