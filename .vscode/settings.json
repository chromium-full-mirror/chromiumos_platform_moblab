{
    "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
    "[typescript]": {
      "editor.formatOnSave": true
    },

    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/node_modules": true,
        "**/*.pyc": {"when": "$(basename).py"},
    },
    "editor.rulers": [
        79
    ],
    "cSpell.words": [
        "Boto",
        "HCEXECUTION",
        "Popen",
        "cherrypy",
        "crbug",
        "datefmt",
        "etime",
        "hcexpect",
        "hcname",
        "hcobj",
        "hcstatus",
        "hcstatuses",
        "isclass",
        "moblabrpc",
        "myobj",
        "pb",
        "pylint",
        "stime",
        "testhc"
    ],

    "java.configuration.runtimes": [
        {
          "name": "JavaSE-11",
          "path": "/usr/lib/jvm/java-11-openjdk-amd64",
          "default": true
        },
      ],

    "cSpell.enabledLanguageIds": [
        "asciidoc",
        "c",
        "cpp",
        "csharp",
        "css",
        "go",
        "handlebars",
        "html",
        "jade",
        "javascript",
        "javascriptreact",
        "json",
        "latex",
        "less",
        "markdown",
        "php",
        "plaintext",
        "proto3",
        "pub",
        "python",
        "restructuredtext",
        "rust",
        "scss",
        "text",
        "typescript",
        "typescriptreact",
        "yml"
    ],
    "files.associations": {
        "Dockerfile*": "dockerfile",
        "docker-compose*": "yaml"
    },
    "python.linting.flake8Enabled": true,
    "python.linting.enabled": true,

    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length=79"
    ]

}


