{
  "extends": "/usr/local/lib/node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "baseUrl": "",
    "declaration": false,
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "es6",
      "ES2017",
      "dom",
      "es2022"
    ],
    "mapRoot": "./",
    "module": "esnext",
    "moduleResolution": "node",
    "sourceMap": true,
    "target": "es2022",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "strictNullChecks": false
  },
  "files": [
    "main.ts",
    "polyfills.ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "test.ts"
  ]
}
