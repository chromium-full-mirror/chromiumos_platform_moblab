# Run tests for moblab test results uploader.

set -eu

readonly home_dir=$(dirname -- "$(readlink -e -- "$0")")
readonly moblab_common_dir=$(cd "${home_dir}"/..; pwd)
export PYTHONPATH="${moblab_common_dir}":"${home_dir}"
cd "${home_dir}"
exec python3 -m pytest tests/ "$@"
