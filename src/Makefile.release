# This makefile is just used to make development easier

BASE_URL=gcr.io/chromeos-partner-moblab

all: rpcserver compose autotest db devserver ssp

rpcserver: export DOCKER_BUILDKIT=1
rpcserver:
	docker build --no-cache -t ${BASE_URL}/moblab-rpcserver:release -f \
		dockerfiles/rpcserver/Dockerfile .
	docker push ${BASE_URL}/moblab-rpcserver:release

compose: export DOCKER_BUILDKIT=1
compose:
	cp dockerfiles/compose/docker-compose.yaml.release dockerfiles/compose/docker-compose.yaml
	docker build --no-cache -t ${BASE_URL}/moblab-compose:release \
		-f dockerfiles/compose/Dockerfile dockerfiles/compose
	docker push ${BASE_URL}/moblab-compose:release


autotest: export DOCKER_BUILDKIT=1
autotest:
	docker build --no-cache -t ${BASE_URL}/moblab-autotest:release \
		-f dockerfiles/autotest/Dockerfile ..
	docker push ${BASE_URL}/moblab-autotest:release

db: export DOCKER_BUILDKIT=1
db:
	docker build --no-cache -t ${BASE_URL}/moblab-db:release \
		-f dockerfiles/db/Dockerfile dockerfiles/db
	docker push ${BASE_URL}/moblab-db:release
	docker build --no-cache -t ${BASE_URL}/moblab-db-init:release \
		-f dockerfiles/db/Dockerfile.db_init dockerfiles/db
	docker push ${BASE_URL}/moblab-db-init:release

devserver: export DOCKER_BUILDKIT=1
devserver:
	docker build --no-cache -t ${BASE_URL}/devserver:release \
		-f dockerfiles/devserver/Dockerfile dockerfiles/devserver
	docker push ${BASE_URL}/devserver:release

ssp: export DOCKER_BUILDKIT=1
ssp:
	docker build --no-cache -t ${BASE_URL}/moblab-ssp:release \
		-f dockerfiles/ssp/Dockerfile dockerfiles/ssp
	docker push ${BASE_URL}/moblab-ssp:release

.PHONY: rpcserver compose db autotest
