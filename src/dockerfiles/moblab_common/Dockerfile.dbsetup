ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

######################################################################

FROM python:3.8-buster as python3

RUN apt-get update && apt-get install --no-install-recommends -yq \
    mariadb-client

COPY dockerfiles/moblab_common/requirements.txt ./
RUN pip3 install --upgrade pip && pip3 install --no-cache-dir -r requirements.txt

RUN mkdir /workdir
COPY moblab_common/ /workdir
COPY dockerfiles/moblab_common/db_setup.sh /workdir/database_models/

RUN addgroup --gid 246 moblab && adduser --ingroup moblab --uid 246 \
    --disabled-password --gecos "" moblab

RUN chown -R moblab:moblab /workdir
RUN chmod uog+rx /workdir/database_models/db_setup.sh

USER moblab:moblab

WORKDIR /workdir/database_models
CMD ["/workdir/database_models/db_setup.sh"]