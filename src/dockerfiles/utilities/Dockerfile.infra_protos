ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=autopush

######################################################################

FROM ${REGISTRY_URI}/protoc:${LABEL} as protoc

######################################################################

FROM ${BASE_REGISTRY_URI}/alpine/git as source

WORKDIR /

RUN git clone https://chromium.googlesource.com/chromiumos/infra/proto
RUN git clone https://chromium.googlesource.com/chromiumos/config
WORKDIR /config
RUN git fetch
RUN git reset --hard 2a23f0c11ed3f1c3e7f3ce73529ebad6a6863b0f
WORKDIR /

######################################################################

FROM ${BASE_REGISTRY_URI}/debian:buster-slim as build

COPY --from=protoc /protoc/* /usr/local/bin/

# Only for local development when the protos are in your local
# client only.
# COPY /proto /proto
# COPY /config /config

COPY --from=source /proto /proto
COPY --from=source /config /config

WORKDIR /protos
RUN protoc -I /proto/src -I /config/proto \
    -I=/usr/local/lib/python3.8/site-packages \
    --experimental_allow_proto3_optional \
    --python_out=. \
    --grpc_python_out=. \
    --plugin=protoc-gen-grpc_python=/usr/local/bin/grpc_python_plugin \
    /proto/src/lab/*.proto \
    /config/proto/chromiumos/longrunning/*.proto


# ######################################################################
FROM ${BASE_REGISTRY_URI}/debian:buster-slim

COPY --from=build /protos /protos
COPY --from=build /config/python/chromiumos/ /protos/chromiumos
