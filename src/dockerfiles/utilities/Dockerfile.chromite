ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers

FROM ${BASE_REGISTRY_URI}/alpine/git

WORKDIR /

RUN git clone https://chromium.googlesource.com/chromiumos/chromite
WORKDIR /chromite
RUN git fetch
# https://chromium.googlesource.com/chromiumos/chromite/+/2bf55e2b7294b6b11156c4f6a39128a8080a00a3
# changes are removing the necessary lib, which are needed for
# functioning of devserver in Moblab. If something is needed from devserver beyond
# this point (before Satlab migration), someone has to take a closer look at
# copying over the files to relevant place in Moblab
RUN git reset --hard 70613acfa9f09b160a56f0f5447b71467cfaf664
RUN rm -rf .git
