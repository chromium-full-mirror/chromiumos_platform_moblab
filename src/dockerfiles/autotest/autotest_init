#!/bin/bash
set -x

passwd=moblab_db_passwd
while ! mysqladmin ping -h db -uchromeosqa-admin -p${passwd} --silent; do
  sleep 1
done

/usr/sbin/apache2ctl start

/usr/local/autotest/database/migrate.py sync -f || true
/usr/local/autotest/frontend/manage.py syncdb --noinput

mkdir -p /usr/local/autotest/results/drone_tmp

/usr/local/autotest/scheduler/monitor_db.py --production /usr/local/autotest/results &
/usr/local/autotest/scheduler/host_scheduler.py --production
