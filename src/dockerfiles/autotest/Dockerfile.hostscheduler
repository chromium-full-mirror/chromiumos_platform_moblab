ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

######################################################################

FROM ${REGISTRY_URI}/moblab-autotest-base:${LABEL}


RUN ln -s /usr/local/lib/python2.7/site-packages/* \
    /moblab/third_party/autotest/site-packages

COPY host_scheduler.sh /
RUN chmod uog+rx /host_scheduler.sh

RUN ln -sf /usr/local/bin/py* /usr/bin

CMD ["/host_scheduler.sh"]