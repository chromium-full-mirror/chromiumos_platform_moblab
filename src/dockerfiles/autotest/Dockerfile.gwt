ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

######################################################################

FROM ${REGISTRY_URI}/gwtcompiler:${LABEL} as build

RUN apt-get update && apt-get install --no-install-recommends -yq  \
    python-pip

RUN python2.7 -m pip install --upgrade pip
RUN python2.7 -m pip install six

COPY ./third_party/autotest/ /moblab/third_party/autotest/
RUN mkdir -p /usr/local/autotest
RUN ln -s /moblab/third_party/autotest/* /usr/local/autotest

RUN /usr/local/autotest/utils/compile_gwt_clients.py -a -e"-Djava.util.prefs.userRoot=/tmp"

RUN rm -rf /moblab/third_party/autotest/frontend/client/www/*.old

######################################################################
FROM ${BASE_REGISTRY_URI}/debian:buster-slim

COPY --from=build /moblab/third_party/autotest/frontend/client/www/ /www/