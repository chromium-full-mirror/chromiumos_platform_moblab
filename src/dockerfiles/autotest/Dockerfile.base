ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

######################################################################

FROM ${REGISTRY_URI}/protoc:${LABEL} as protoc

######################################################################

FROM ${REGISTRY_URI}/moblab_common:${LABEL} as common

######################################################################

FROM alpine/git as source

WORKDIR /

RUN git clone https://chromium.googlesource.com/chromiumos/chromite
WORKDIR /chromite
RUN git fetch
RUN git reset --hard 8196d0bfd0b3b8fbf7f7dbb8310ac43b80311f79

######################################################################

FROM debian:buster-slim as protobuild

COPY --from=protoc /protoc/* /usr/local/bin/

COPY ./third_party/autotest/tko/ /moblab/third_party/autotest/tko/

RUN protoc --proto_path /moblab/third_party/autotest/tko \
    --python_out=/moblab/third_party/autotest/tko \
    /moblab/third_party/autotest/tko/tko.proto

######################################################################


FROM python:2.7-slim-buster

RUN addgroup --gid 246 moblab && adduser --ingroup moblab \
    --uid 246 --disabled-password --gecos "" moblab

COPY --chown=moblab ./third_party/autotest /moblab/third_party/autotest
COPY --chown=moblab --from=protobuild /moblab/third_party/autotest/tko/*pb2* /moblab/third_party/autotest/tko/

RUN rm -rf /moblab/third_party/autotest/site-packages
RUN mkdir -p /moblab/third_party/autotest/site-packages

RUN ln -sf /usr/local/bin/py* /usr/bin

RUN apt-get update && apt-get install --no-install-recommends -yq  \
    cmake \
    default-libmysqlclient-dev \
    gcc-multilib \
    libssl-dev \
    mariadb-client \
    python-pip \
    zlib1g-dev

COPY src/dockerfiles/autotest/requirements.txt ./

RUN python2.7 -m pip install --upgrade pip
RUN python2.7 -m pip install -r requirements.txt

WORKDIR /

COPY --chown=moblab --from=source /chromite /chromite
COPY src/dockerfiles/autotest/setup_chromite.py /
RUN python2.7 /setup_chromite.py install

RUN apt purge -yq gcc-multilib python-pip cmake libssl-dev
RUN apt autoremove -yq
RUN apt-get clean

WORKDIR /wheels
COPY --from=common /wheel/*py2* .
RUN pip install *.whl
RUN rm -rf /wheels

WORKDIR /shadow_config
COPY --chown=moblab src/dockerfiles/autotest/shadow_config.ini .
RUN chmod uog+rw ./shadow_config.ini
RUN ln -s /shadow_config/shadow_config.ini /moblab/third_party/autotest/shadow_config.ini

RUN ln -s /moblab/third_party/autotest /usr/local/autotest
RUN ln -s /chromite /usr/local/autotest/site-packages/chromite

RUN mkdir -p /moblab/third_party/autotest/logs
RUN mkdir -p /moblab/third_party/autotest/results
RUN mkdir -p /moblab/third_party/autotest/leases
RUN mkdir -p /moblab/third_party/autotest/containers

RUN chown -R moblab:moblab /moblab/third_party/autotest