ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=autopush

######################################################################

FROM ${REGISTRY_URI}/protoc:${LABEL} as protoc

######################################################################

FROM ${REGISTRY_URI}/moblab_common:${LABEL} as common

######################################################################

FROM ${REGISTRY_URI}/chromite:${LABEL} as chromite

######################################################################

FROM ${BASE_REGISTRY_URI}/debian:buster-slim as protobuild

COPY --from=protoc /protoc/* /usr/local/bin/

COPY ./third_party/autotest/tko/ /usr/local/autotest/tko/

RUN protoc --proto_path /usr/local/autotest/tko \
    --python_out=/usr/local/autotest/tko \
    /usr/local/autotest/tko/tko.proto

######################################################################


FROM ${BASE_REGISTRY_URI}/python:3.7-slim-buster

RUN addgroup --gid 246 moblab && adduser --ingroup moblab \
    --uid 246 --disabled-password --gecos "" moblab

COPY --chown=moblab ./third_party/autotest /usr/local/autotest
COPY --chown=moblab --from=protobuild /usr/local/autotest/tko/*pb2* /usr/local/autotest/tko/

RUN rm -rf /usr/local/autotest/site-packages
RUN mkdir -p /usr/local/autotest/site-packages

RUN ln -sf /usr/local/bin/py* /usr/bin

RUN apt-get update && apt-get install --no-install-recommends -yq  \
    cmake \
    default-libmysqlclient-dev \
    gcc-multilib \
    libssl-dev \
    mariadb-client \
    python-pip \
    zlib1g-dev \
    python3.7-distutils \
    curl

COPY src/dockerfiles/autotest/requirements.txt ./

RUN pip install --upgrade pip \
    && pip install -r requirements.txt

WORKDIR /

COPY --chown=moblab --from=chromite /chromite /chromite
COPY src/dockerfiles/autotest/setup_chromite.py /
RUN python3 /setup_chromite.py install

# Installs Moblab API client library
WORKDIR /tmp/moblab_api_client_library
RUN curl https://storage.googleapis.com/moblab-api-distribution/python-client-library/google-chromeos-moblab-python-1.2.0-beta.tar.gz -o google-chromeos-moblab-python-1.2.0-beta.tar.gz \
    && tar -xvzf google-chromeos-moblab-python-1.2.0-beta.tar.gz \
    && python3 -m pip install . \
    && rm -rf /tmp/moblab_api_client_library

RUN apt purge -yq gcc-multilib python-pip cmake libssl-dev curl \
    && apt autoremove -yq \
    && apt-get clean

WORKDIR /wheels
COPY --from=common /wheel/*py3* .
RUN pip install *.whl \
    && rm -rf /wheels

WORKDIR /shadow_config
COPY --chown=moblab src/dockerfiles/autotest/shadow_config.ini .
RUN chmod uog+rw ./shadow_config.ini \
    && ln -s /shadow_config/shadow_config.ini /usr/local/autotest/shadow_config.ini

RUN ln -s /chromite /usr/local/autotest/site-packages/chromite

RUN mkdir -p /usr/local/autotest/logs \
    && mkdir -p /usr/local/autotest/results \
    && mkdir -p /usr/local/autotest/leases \
    && mkdir -p /usr/local/autotest/containers

RUN chown -R moblab:moblab /usr/local/autotest

ENV PYTHONPATH=/usr/local/autotest:/usr/local/autotest/site-packages