ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=autopush

######################################################################

ARG LABEL
ARG REGISTRY_URI
FROM ${BASE_REGISTRY_URI}/partner-testing-rsa:latest as partner_key_image

FROM ${REGISTRY_URI}/moblab-autotest-base:${LABEL}

ARG GID=412

RUN apt-get update && apt-get install --no-install-recommends -yq \
    apache2 \
    apache2-utils \
    apt-transport-https  \
    bzip2  \
    ca-certificates \
    curl \
    gnupg \
    iputils-ping  \
    libapache2-mod-wsgi-py3 \
    libcap2-bin \
    mariadb-client \
    pbzip2 \
    rsync \
    ssh \
    sudo \
    unzip \
    xz-utils

RUN pip install docker

# Install the google cloud sdk
RUN echo \
    "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] \
    http://packages.cloud.google.com/apt cloud-sdk main" | \
    tee -a /etc/apt/sources.list.d/google-cloud-sdk.list && \
    curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | \
    apt-key --keyring /usr/share/keyrings/cloud.google.gpg  \
    add - && apt-get update -y && apt-get install google-cloud-sdk -y

RUN rm -rf /usr/lib/google-cloud-sdk/bin/anthoscli \
    /usr/lib/google-cloud-sdk/bin/kuberun

# Ping is used to check DUT's are around needs this capability added to run
# as non root user.
RUN setcap cap_net_raw+ep /bin/ping

RUN apt purge -yq libcap2-bin

# Apache setuop
RUN a2dismod mpm_event && \
    a2enmod mpm_prefork && \
    a2enmod rewrite && \
    a2enmod headers && \
    a2enmod wsgi && \
    a2enmod cgi

RUN sed -i 's/www-data/moblab/g' /etc/apache2/envvars

RUN rm /etc/apache2/ports.conf
RUN touch /etc/apache2/ports.conf
RUN rm /etc/apache2/sites-enabled/*
COPY apache-docker.conf /etc/apache2/mods-available
RUN rm -f /etc/apache2/mods-enabled/apache-docker.conf
RUN ln -s /etc/apache2/mods-available/apache-docker.conf /etc/apache2/mods-enabled/apache-docker.conf
RUN chown -R moblab:moblab /etc/apache2/mods-enabled/*
RUN mkdir -p /var/log/apache2/
RUN chmod uog+rw /var/log/apache2
RUN chmod uog+rw /run
RUN chown -R moblab /var/log/apache2
RUN chown -R root /etc/sudoers.d

RUN echo "moblab   ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN apt autoremove -yq
RUN apt-get clean

RUN ln -s /usr/local/lib/python3.7/site-packages/* /usr/local/autotest/site-packages

COPY afe_startup.sh /
RUN chmod uog+rx /afe_startup.sh

RUN addgroup --gid $GID docker
USER moblab
ENV USER=moblab

RUN mkdir -p /home/moblab
RUN mkdir -p /home/moblab/.ssh

# add partner_testing_rsa from the container stored in a separate location
COPY --chown=moblab --from=partner_key_image /partner_testing_rsa /chromite/ssh_keys/
RUN cp /chromite/ssh_keys/* /home/moblab/.ssh/

RUN chmod -R 600 /home/moblab/.ssh/*
COPY ssh_config /home/moblab/.ssh/config
RUN touch /home/moblab/.boto
RUN sudo usermod -aG docker $USER

ENV PYTHONPATH=/usr/local/autotest:/usr/local/autotest/site-packages

EXPOSE 8888
CMD ["/afe_startup.sh"]
