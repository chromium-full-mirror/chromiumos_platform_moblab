ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=autopush

FROM ${REGISTRY_URI}/protoc:${LABEL} as protoc

######################################################################

FROM ${BASE_REGISTRY_URI}/alpine/git as source

WORKDIR /

RUN git clone https://chromium.googlesource.com/chromiumos/infra/lucifer
RUN rm -rf lucifer/.git

######################################################################

FROM ${BASE_REGISTRY_URI}/alpine/git as downloads

WORKDIR /
RUN wget https://dl.google.com/go/go1.17.3.linux-amd64.tar.gz

######################################################################

FROM ${BASE_REGISTRY_URI}/debian:buster-slim as build

COPY --from=downloads /*.gz /

RUN apt-get update && apt-get install --no-install-recommends -yq \
	wget unzip git ca-certificates sed

#Install Go
RUN tar -xvf go1.17.3.linux-amd64.tar.gz
RUN mv go /usr/local

COPY --from=source /lucifer /lucifer
COPY --from=protoc /protoc/* /usr/local/bin/


WORKDIR /lucifer/src

ENV GOROOT=/usr/local/go
ENV GOPATH=/lucifer
ENV PATH=$GOPATH/bin:$GOROOT/bin:$PATH


RUN git clone https://chromium.googlesource.com/chromiumos/infra/proto
RUN protoc \
	--proto_path /lucifer/src/proto/src/test_platform/side_effects \
	--python_out=/ \
	/lucifer/src/proto/src/test_platform/side_effects/config.proto

WORKDIR /lucifer/src/lucifer 
RUN go build -o /usr/bin/lucifer ./cmd/lucifer/

####################################################################

FROM ${BASE_REGISTRY_URI}/debian:buster-slim

COPY --from=build /*_pb* /
COPY --from=build /usr/bin/lucifer /usr/bin/lucifer
