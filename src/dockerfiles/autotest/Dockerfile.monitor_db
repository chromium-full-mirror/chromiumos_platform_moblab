ARG BASE_REGISTRY_URI=us-docker.pkg.dev/chromeos-partner-moblab/base-containers
ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=autopush

FROM ${REGISTRY_URI}/moblab-autotest-lucifer:${LABEL} as lucifer

######################################################################

FROM ${BASE_REGISTRY_URI}/alpine/git as fw-testing-configs

WORKDIR /

RUN git clone https://chromium.googlesource.com/chromiumos/platform/fw-testing-configs

######################################################################

ARG REGISTRY_URI
ARG LABEL

FROM ${REGISTRY_URI}/moblab-autotest-base:${LABEL}

ARG GID=412

RUN apt-get update && apt-get install --no-install-recommends -yq    \
    iputils-ping \
    libcap2-bin \
    procps \
    python-pip \
    rsync \
    ssh \
    sudo

RUN setcap cap_net_raw+ep /bin/ping

COPY monitor_db.sh /
RUN chmod uog+rx /monitor_db.sh

RUN ln -s /usr/local/lib/python3.7/site-packages/* /usr/local/autotest/site-packages

COPY --from=lucifer /usr/bin/lucifer /usr/bin/lucifer
COPY --chown=moblab --from=lucifer /*_pb*  /usr/local/autotest/utils/side_effects/proto/

RUN mkdir -p /usr/local/autotest/server/cros/faft
COPY --chown=moblab --from=fw-testing-configs /fw-testing-configs/ /usr/local/autotest/server/cros/faft/fw-testing-configs/

# Need to be in docker group to use docker API
RUN addgroup --gid $GID docker
RUN usermod -aG docker moblab

RUN apt purge -yq python-pip libcap2-bin
RUN apt autoremove -yq
RUN apt-get clean

RUN ln -sf /usr/local/bin/py* /usr/bin

RUN echo "moblab     ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV PYTHONPATH=/usr/local/autotest/venv:/usr/local/autotest:/usr/local/autotest/site-packages

# Some python files (control files) out of our control still have autotest_lib
# link it back to the /usr/local/autotest directory to effectivly remove
# autotest_lib.
# Some other file under our control stil have autotest_lib but because they
# are pickled and sent to the DUT where the code expects autotest_lib they
# autotest_lib has to remain in those files although it is a noop in our code.
RUN ln -s /usr/local/autotest /usr/local/autotest/autotest_lib

CMD ["/monitor_db.sh"]
