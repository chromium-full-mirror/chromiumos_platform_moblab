ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

######################################################################

FROM alpine/git as source

WORKDIR /infra
RUN git clone https://chromium.googlesource.com/chromiumos/infra_virtualenv

######################################################################

FROM ${REGISTRY_URI}/moblab-autotest-lucifer:${LABEL} as lucifer

######################################################################

FROM ${REGISTRY_URI}/moblab-autotest-base:${LABEL}

RUN apt-get update && apt-get install --no-install-recommends -yq    \
 iputils-ping \
 libcap2-bin \
 procps \
 python-pip \
 rsync \
 ssh \
 sudo

RUN setcap cap_net_raw+ep /bin/ping

RUN python2.7 -m pip install virtualenv==16.7.10

COPY --from=source /infra /infra
RUN ln -s /infra/* /opt

COPY monitor_db.sh /
RUN chmod uog+rx /monitor_db.sh

RUN ln -s /usr/local/lib/python2.7/site-packages/* /moblab/third_party/autotest/site-packages

COPY --from=lucifer /usr/bin/lucifer /usr/bin/lucifer
COPY --chown=moblab --from=lucifer /*_pb* /moblab/third_party/autotest/utils/side_effects/proto/

ENV CROS_VENV_CACHE=/usr/local/.cros-venv-cache
RUN mkdir -p /usr/local/.cros-venv-cache
RUN chown moblab /usr/local/.cros-venv-cache
#RUN /usr/local/autotest/bin/job_reporter -h

# Need to be in docker group to use docker API
RUN addgroup --gid 412 docker
RUN sudo usermod -aG docker moblab

RUN apt purge -yq python-pip libcap2-bin
RUN apt-get clean



RUN echo "moblab     ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

CMD ["/monitor_db.sh"]