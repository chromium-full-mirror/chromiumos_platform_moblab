ARG REGISTRY_URI=gcr.io/chromeos-partner-moblab
ARG LABEL=release

# ######################################################################

ARG REGISTRY_URI
ARG LABEL

FROM ${REGISTRY_URI}/moblab-autotest-base:${LABEL}

RUN apt-get update && apt-get install --no-install-recommends -yq  \
 python-pip

COPY job_aborter.sh /
RUN chmod uog+rx /job_aborter.sh

RUN ln -s /usr/local/lib/python2.7/site-packages/* /moblab/third_party/autotest/site-packages

RUN apt purge -yq python-pip
RUN apt autoremove -yq
RUN apt-get clean

RUN ln -sf /usr/local/bin/py* /usr/bin

ENV PYTHONPATH=/moblab/third_party/autotest:/usr/local/autotest/venv:/moblab/third_party/autotest/site-packages

CMD ["/job_aborter.sh"]
